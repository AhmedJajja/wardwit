# WardWit Tutor Backend Environment Configuration
# ==============================================================================
# SECURITY NOTICE:
# 1. Never prefix server keys with VITE_ (Vite bundles VITE_* into client JS!).
# 2. Never commit .env files containing real secrets to source control.
# 3. GEMINI_API_KEY is used exclusively by the server process (server/index.ts).
# ==============================================================================

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Selection
# Default: gemini-2.5-flash (recommended for low-latency tutoring)
# Official documentation: https://ai.google.dev/gemini-api/docs/models/gemini
GEMINI_MODEL=gemini-2.5-flash

# Local Server Configuration
PORT=3001
ALLOWED_CORPUS_ID=wardwit-approved-core
